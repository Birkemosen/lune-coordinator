  "font": {
    "font": {
      "value": "\"Geist\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "use": "Al UI-tekst. Geist hentes ikke fra nettet; systemfonten er fallback."
    },
    "font-mono": {
      "value": "\"Geist Mono\", ui-monospace, Menlo, Consolas, monospace",
      "use": "Kun enhedslog."
    }
  },
  "type": {
    "fs-xs": {
      "value": ".6875rem",
      "px": 11,
      "use": "Zone-ID, akser, badges, hints."
    },
    "fs-sm": {
      "value": ".8125rem",
      "px": 13,
      "use": "Labels, knapper, tabeller, undertitler."
    },
    "fs-md": {
      "value": ".9375rem",
      "px": 15,
      "use": "Brødtekst og feltværdier."
    },
    "fs-lg": {
      "value": "1.125rem",
      "px": 18,
      "use": "Paneltitler, værdier i zonefelter."
    },
    "fs-xl": {
      "value": "1.5rem",
      "px": 24,
      "use": "Nøgletal (metric)."
    },
    "fs-2xl": {
      "value": "2rem",
      "px": 32,
      "use": "Visningstitel (h2), målet i klima-kontrollen."
    },
    "fs-hero": {
      "value": "4rem",
      "px": 64,
      "use": "Én aktuel temperatur pr. visning."
    },
    "fs-panel": {
      "value": "var(--fs-lg)",
      "px": 18,
      "use": "Paneltitel (h3). Kompakt: 15 px."
    },
    "fs-view": {
      "value": "var(--fs-2xl)",
      "px": 32,
      "use": "Visningstitel (h2). Mobil: --fs-lg. Kompakt: 26 px."
    }
  },
