  "font": {
    "font": {
      "value": "\"Geist\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
      "use": "Al UI-tekst. Geist hentes ikke fra nettet; systemfonten er fallback."
    },
    "font-mono": {
      "value": "\"Geist Mono\", ui-monospace, Menlo, Consolas, monospace",
      "use": "Kun enhedslog."
    }
  },
  "type": {
    "fs-xs": {
      "value": ".6875rem",
      "px": 11,
      "use": "Zone-ID, akser, badges, hints."
    },
    "fs-sm": {
      "value": ".8125rem",
      "px": 13,
      "use": "Labels, knapper, tabeller, undertitler."
    },
    "fs-md": {
      "value": ".9375rem",
      "px": 15,
      "use": "Brødtekst og feltværdier."
    },
    "fs-lg": {
      "value": "1.125rem",
      "px": 18,
      "use": "Paneltitler, værdier i zonefelter."
    },
    "fs-xl": {
      "value": "1.5rem",
      "px": 24,
      "use": "Nøgletal (metric)."
    },
    "fs-2xl": {
      "value": "2rem",
      "px": 32,
      "use": "Visningstitel (h2), målet i klima-kontrollen."
    },
    "fs-hero": {
      "value": "4rem",
      "px": 64,
      "use": "Én aktuel temperatur pr. visning."
    },
    "fs-display": {
      "value": "3rem",
      "px": 48,
      "use": "Overskriften i Hjems hovedsektion (Touch). Mobil: --fs-2xl."
    },
    "fs-panel": {
      "value": "var(--fs-lg)",
      "px": 18,
      "use": "Paneltitel (h3). Kompakt: 15 px."
    },
    "fs-view": {
      "value": "var(--fs-2xl)",
      "px": 32,
      "use": "Visningstitel (h2). Mobil: --fs-lg. Kompakt: 26 px."
    }
  },
  "space": {
    "space-1": {
      "value": "4px"
    },
    "space-2": {
      "value": "8px"
    },
    "space-3": {
      "value": "12px"
    },
    "space-4": {
      "value": "16px"
    },
    "space-5": {
      "value": "24px"
    },
    "space-6": {
      "value": "32px"
    },
    "space-7": {
      "value": "48px"
    }
  },
  "radius": {
    "r-card": {
      "value": "16px",
      "use": "Paneler."
    },
    "r-sheet": {
      "value": "24px",
      "use": "Ark (.sheet) og andre svævende flader over indhold."
    },
    "r-tile": {
      "value": "14px",
      "use": "Zonefelter."
    },
    "r-field": {
      "value": "12px",
      "use": "Inputs, beskeder, log."
    },
    "r-pill": {
      "value": "999px",
      "use": "Knapper, steppere, segmenter, tilstand, badges."
    }
  },
  "size": {
    "hit": {
      "value": "44px",
      "use": "Mindste trykflade og kontrolhøjde. 44 px standard, 48 px på touch, 36 px kompakt (mus på skærm ≥ 1024 px, density.compact)."
    },
    "field-gap": {
      "value": "var(--space-3)",
      "use": "Afstand mellem felter i et underafsnit. Label → kontrol er min(--space-2, --field-gap)."
    },
    "panel-pad": {
      "value": "var(--space-5)",
      "use": "Indvendig luft i panel. Mobil: --space-4."
    },
    "panel-gap": {
      "value": "var(--space-4)",
      "use": "Afstand mellem blokke i panel."
    },
    "row-h": {
      "value": "40px",
      "use": "Mindste højde på en .kv- eller tabelrække."
    },
    "tile-h": {
      "value": "auto",
      "use": "Mindste højde på zonefelt og systemfelt. Naturlig højde; 52 px kompakt."
    },
    "room-min": {
      "value": "152px",
      "use": "Mindste bredde på et rumfelt i varmekortet; felterne vokser efter rummets areal."
    },
    "container": {
      "value": "1200px",
      "use": "Maks. indholdsbredde."
    },
    "sheet-w": {
      "value": "520px",
      "use": "Bredde på arket (.sheet) på bred skærm."
    },
    "sheet-inset": {
      "value": "12px",
      "use": "Arkets afstand til vinduets kanter."
    },
    "sys-nav-w": {
      "value": "240px",
      "use": "System-sidens kategoriliste."
    },
    "sys-main-w": {
      "value": "640px",
      "use": "Maks. bredde på System-sidens indhold og arkets indstillinger."
    },
    "setting-h": {
      "value": "52px",
      "use": "Mindste højde på en række i en grupperet liste (.setting)."
    }
  },
  "shadow": {
    "card-edge": {
      "value": "0 0 0 1px var(--card-edge-c)",
      "use": "Kortkant (kun synlig i lyst tema)."
    },
    "float": {
      "value": "inset 0 1px 0 rgba(255,255,255,.07), 0 0 0 1px var(--border), 0 30px 80px rgba(0,0,0,.5)",
      "use": "Svævende flader: ark og bekræftelse. Aldrig på paneler."
    },
    "lift": {
      "value": "0 0 0 1px var(--card-edge-c), 0 1px 2px var(--lift-shadow-c), 0 10px 28px var(--lift-shadow-c)",
      "use": "Små kort over hovedsektionens tekstur (.hero-fact). Aldrig på paneler eller felter."
    }
  },
  "motion": {
    "ease": {
      "value": "cubic-bezier(.4,0,.2,1)",
      "use": "Alle overgange."
    },
    "dur": {
      "value": "200ms",
      "use": "Farve- og baggrundsskift."
    },
    "dur-slow": {
      "value": "360ms",
      "use": "Størrelsesskift, fx navbaren der bliver smal ved scroll."
    }
  },
  "density": {
    "note": "Kompakt tæthed: mus (pointer: fine) på skærm ≥ 1024 px, eller .app[data-density=\"compact\"]. .app[data-density=\"comfortable\"] slår den fra. Touch er altid uændret. Værdierne erstatter size/type-tokens med samme navn; komponentregler står i css/lune-ui.src.css mellem @compact:begin og @compact:end.",
    "media": "(pointer: fine) and (min-width: 1024px)",
    "compact": {
      "hit": "36px",
      "field-gap": "6px",
      "panel-pad": "18px",
      "panel-gap": "14px",
      "fs-panel": "15px",
      "fs-view": "26px",
      "row-h": "36px",
      "tile-h": "52px"
    }
