{
  "$meta": {
    "name": "Lune Design System",
    "version": "2.0.0",
    "note": "Eneste kilde til farver, typografi, afstande, radier og bevægelse. Rediger her, kør tools/lds_build.py. Farver har en light- og en dark-værdi og bliver til light-dark() i CSS. {navn} refererer til et andet token."
  },
  "color": {
    "surface": {
      "bg": {
        "light": "#fbfaf8",
        "dark": "#121210",
        "use": "Sidens baggrund."
      },
      "card": {
        "light": "#e4e2da",
        "dark": "#1e1e1b",
        "use": "Paneler og zonefelter. Den eneste løftede flade."
      },
      "raised": {
        "light": "#d7d5cc",
        "dark": "#282824",
        "use": "Flader inde i et kort: segmentbaggrund, sekundærknapper, hover i lister."
      },
      "field": {
        "light": "#ffffff",
        "dark": "#1a1a17",
        "use": "Baggrund i inputs, steppere og menuer."
      },
      "border": {
        "light": "rgba(26,26,20,.16)",
        "dark": "rgba(245,245,240,.10)",
        "use": "Skillelinjer i lister og tabeller. Aldrig rundt om paneler."
      },
      "field-edge": {
        "light": "rgba(26,26,20,.24)",
        "dark": "rgba(245,245,240,.10)",
        "use": "Kant på inputs og steppere."
      },
      "card-edge-c": {
        "light": "rgba(26,26,20,.08)",
        "dark": "transparent",
        "use": "Hårfin kant på kort i lyst tema."
      }
    },
    "text": {
      "fg": {
        "light": "#161614",
        "dark": "#f5f5f0",
        "use": "Primær tekst og tal."
      },
      "muted": {
        "light": "#55544f",
        "dark": "#a3a39c",
        "use": "Labels, undertitler, enheder."
      },
      "faint": {
        "light": "#66655f",
        "dark": "#8d8d86",
        "use": "Akser og meget små labels. Laveste tilladte tekstkontrast."
      }
    },
    "inverse": {
      "inv-bg": {
        "ref": "fg",
        "use": "Inverteret flade: valgt zone, aktiv tilstand, primær knap, tændt switch."
      },
      "inv-fg": {
        "ref": "bg",
        "use": "Tekst på inverteret flade."
      }
    },
    "heat": {
      "accent": {
        "light": "#e8630a",
        "dark": "#d96c2f",
        "use": "Varme som flade: niveausegmenter, bjælker, preload-bånd, afvigelse fra mål. Aldrig som tekst på lys baggrund."
      },
      "accent-ink": {
        "light": "#a63f08",
        "dark": "#e8844a",
        "use": "Varme som tekst, og som badge-baggrund med hvid tekst."
      },
      "accent-glow": {
        "light": "rgba(232,99,10,.35)",
        "dark": "rgba(217,108,47,.45)",
        "use": "Glød på tændte niveausegmenter."
      },
      "seg-off": {
        "light": "rgba(26,26,20,.15)",
        "dark": "rgba(245,245,240,.10)",
        "use": "Slukkede segmenter og tomme bjælker."
      },
      "on-accent-ink": {
        "light": "#ffffff",
        "dark": "#161614",
        "use": "Tekst på accent-ink-flader (fx 'Kalder'-badge): hvid i lyst, næsten sort i mørkt tema."
      }
    },
    "status": {
      "info": {
        "light": "#1f5f8b",
        "dark": "#6ca0d0",
        "use": "Vejr, prognoser, sensorer, forbindelser, returtemperatur."
      },
      "ok": {
        "light": "#27611d",
        "dark": "#74b55e",
        "use": "Online, lært, i orden."
      },
      "warn": {
        "light": "#6e4c00",
        "dark": "#cca840",
        "use": "Kræver opmærksomhed snart: mangler læring, manuel tilstand, zone halter efter mål."
      },
      "danger": {
        "light": "#a52f2f",
        "dark": "#d97a76",
        "use": "Fejl der kræver handling nu. Destruktive handlinger."
      },
      "violet": {
        "light": "#5f41a3",
        "dark": "#9179ce",
        "use": "Læring, kalibrering og gruppering."
      },
      "info-bg": {
        "light": {
          "tint": "info",
          "chroma": 0.022,
          "dL": -0.035
        },
        "dark": "#18222b",
        "use": "Baggrund for info-besked og -badge."
      },
      "ok-bg": {
        "light": {
          "tint": "ok",
          "chroma": 0.022,
          "dL": -0.035
        },
        "dark": "#1a2717",
        "use": "Baggrund for ok-besked og -badge."
      },
      "warn-bg": {
        "light": {
          "tint": "warn",
          "chroma": 0.022,
          "dL": -0.035
        },
        "dark": "#25221a",
        "use": "Baggrund for advarsel."
      },
      "danger-bg": {
        "light": {
          "tint": "danger",
          "chroma": 0.022,
          "dL": -0.035
        },
        "dark": "#2a1716",
        "use": "Baggrund for fejlpanel og fare-knap."
      },
      "violet-bg": {
        "light": {
          "tint": "violet",
          "chroma": 0.022,
          "dL": -0.035
        },
        "dark": "#211b31",
        "use": "Baggrund for lærings-besked og -badge."
      },
      "focus": {
        "light": "rgba(232,99,10,.9)",
        "dark": "rgba(240,122,42,.9)",
        "use": "Fokusring (tastatur)."
      }
    }
  },
