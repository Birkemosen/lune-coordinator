{
  "$meta": {
    "name": "Lune Design System",
    "version": "2.3.11",
    "note": "Eneste kilde til farver, typografi, afstande, radier og bevægelse. Rediger her, kør tools/lds_build.py. Farver har en light- og en dark-værdi og bliver til light-dark() i CSS. {navn} refererer til et andet token."
  },
  "color": {
    "surface": {
      "bg": {
        "light": "#fbfaf8",
        "dark": "#0e0f10",
        "use": "Sidens baggrund."
      },
      "card": {
        "light": "#e4e2da",
        "dark": "#191a1c",
        "use": "Paneler og zonefelter. Den eneste løftede flade."
      },
      "raised": {
        "light": "#d7d5cc",
        "dark": "#232427",
        "use": "Flader inde i et kort: segmentbaggrund, sekundærknapper, hover i lister."
      },
      "lift-bg": {
        "light": "#fbfaf8",
        "dark": "#232427",
        "use": "Små kort, der svæver over Hjems hovedsektion (.hero-fact). Altid med --lift."
      },
      "lift-shadow-c": {
        "light": "rgba(26,26,20,.10)",
        "dark": "rgba(0,0,0,.45)",
        "use": "Skyggefarven i --lift."
      },
      "field": {
        "light": "#ffffff",
        "dark": "#141517",
        "use": "Baggrund i inputs, steppere og menuer."
      },
      "border": {
        "light": "rgba(26,26,20,.16)",
        "dark": "rgba(240,242,245,.09)",
        "use": "Skillelinjer i lister og tabeller. Aldrig rundt om paneler."
      },
      "field-edge": {
        "light": "rgba(26,26,20,.24)",
        "dark": "rgba(240,242,245,.13)",
        "use": "Kant på inputs og steppere."
      },
      "card-edge-c": {
        "light": "rgba(26,26,20,.08)",
        "dark": "rgba(240,242,245,.05)",
        "use": "Hårfin kant på kort i lyst tema."
      }
    },
    "text": {
      "fg": {
        "light": "#161614",
        "dark": "#f3f4f6",
        "use": "Primær tekst og tal."
      },
      "muted": {
        "light": "#55544f",
        "dark": "#a2a6ad",
        "use": "Labels, undertitler, enheder."
      },
      "faint": {
        "light": "#66655f",
        "dark": "#8a8f97",
        "use": "Akser og meget små labels. Laveste tilladte tekstkontrast."
      }
    },
    "inverse": {
      "inv-bg": {
        "ref": "fg",
        "use": "Inverteret flade: valgt zone, aktiv tilstand, primær knap, tændt switch."
      },
      "inv-fg": {
        "ref": "bg",
        "use": "Tekst på inverteret flade."
      }
    },
    "heat": {
      "accent": {
        "light": "#e8630a",
        "dark": "#f67400",
        "use": "Varme som flade: niveausegmenter, bjælker, preload-bånd, afvigelse fra mål. Aldrig som tekst på lys baggrund."
      },
      "accent-ink": {
        "light": "#a63f08",
        "dark": "#ff9a4a",
        "use": "Varme som tekst, og som badge-baggrund med hvid tekst."
      },
      "accent-glow": {
        "light": "rgba(232,99,10,.35)",
        "dark": "rgba(246,116,0,.50)",
        "use": "Glød på tændte niveausegmenter."
      },
      "seg-off": {
        "light": "rgba(26,26,20,.15)",
        "dark": "rgba(240,242,245,.10)",
        "use": "Slukkede segmenter og tomme bjælker."
      },
      "on-accent-ink": {
        "light": "#ffffff",
        "dark": "#111214",
        "use": "Tekst på accent-ink-flader (fx 'Kalder'-badge): hvid i lyst, næsten sort i mørkt tema."
      },
      "heat-fill": {
        "light": "#e8630a",
        "dark": "#e8630a",
        "use": "Solid varme-flade: 'Kalder'-badge, ikonbrikker. Apex' orange i begge temaer; tekst på den: on-heat-fill."
      },
      "water-fill": {
        "light": "#007a75",
        "dark": "#007a75",
        "use": "Solid vand/flow-flade (dom-water): ikonbrik for cirkulation. Samme i begge temaer; tekst og ikon: on-fill."
      },
      "on-heat-fill": {
        "light": "#111214",
        "dark": "#111214",
        "use": "Tekst på heat-fill (5,6:1)."
      }
    },
    "status": {
      "info": {
        "light": "#1f5f8b",
        "dark": "#65b2f1",
        "use": "Vejr, prognoser, sensorer, forbindelser, returtemperatur."
      },
      "ok": {
        "light": "#27611d",
        "dark": "#70ca68",
        "use": "Online, lært, i orden."
      },
      "warn": {
        "light": "#6e4c00",
        "dark": "#fcb442",
        "use": "Kræver opmærksomhed snart: mangler læring, manuel tilstand, zone halter efter mål."
      },
      "danger": {
        "light": "#a52f2f",
        "dark": "#ff6362",
        "use": "Fejl der kræver handling nu. Destruktive handlinger."
      },
      "violet": {
        "light": "#5f41a3",
        "dark": "#b298f9",
        "use": "Læring, kalibrering og gruppering."
      },
      "info-bg": {
        "light": {
          "tint": "info",
          "chroma": 0.04,
          "dL": -0.02
        },
        "dark": {
          "tint": "info",
          "chroma": 0.055,
          "dL": 0.045
        },
        "use": "Baggrund for info-besked og -badge. Lyst tema: afledt af kortet (se $tint)."
      },
      "ok-bg": {
        "light": {
          "tint": "ok",
          "chroma": 0.04,
          "dL": -0.02
        },
        "dark": {
          "tint": "ok",
          "chroma": 0.055,
          "dL": 0.045
        },
        "use": "Baggrund for ok-besked og -badge."
      },
      "warn-bg": {
        "light": {
          "tint": "warn",
          "chroma": 0.04,
          "dL": -0.02
        },
        "dark": {
          "tint": "warn",
          "chroma": 0.055,
          "dL": 0.045
        },
        "use": "Baggrund for advarsel."
      },
      "danger-bg": {
        "light": {
          "tint": "danger",
          "chroma": 0.04,
          "dL": -0.02
        },
        "dark": {
          "tint": "danger",
          "chroma": 0.055,
          "dL": 0.045
        },
        "use": "Baggrund for fejlpanel og fare-knap."
      },
      "violet-bg": {
        "light": {
          "tint": "violet",
          "chroma": 0.04,
          "dL": -0.02
        },
        "dark": {
          "tint": "violet",
          "chroma": 0.055,
          "dL": 0.045
        },
        "use": "Baggrund for lærings-besked og -badge."
      },
      "focus": {
        "light": "rgba(232,99,10,.9)",
        "dark": "rgba(255,138,61,.9)",
        "use": "Fokusring (tastatur)."
      },
      "info-fill": {
        "light": "#2e72a0",
        "dark": "#2e72a0",
        "use": "Solid flade for info: knapper, ikonbrikker, kanter. Apex' værdi i begge temaer; tekst på den: on-fill."
      },
      "ok-fill": {
        "light": "#358028",
        "dark": "#358028",
        "use": "Solid flade for ok: knapper, ikonbrikker, kanter. Apex' værdi i begge temaer; tekst på den: on-fill."
      },
      "warn-fill": {
        "light": "#fcaa2d",
        "dark": "#fcaa2d",
        "use": "Solid flade for warn: knapper, ikonbrikker, kanter. Apex' værdi i begge temaer; tekst på den: on-warn-fill."
      },
      "danger-fill": {
        "light": "#b83838",
        "dark": "#b83838",
        "use": "Solid flade for danger: knapper, ikonbrikker, kanter. Apex' værdi i begge temaer; tekst på den: on-fill."
      },
      "violet-fill": {
        "light": "#7050b4",
        "dark": "#7050b4",
        "use": "Solid flade for violet: knapper, ikonbrikker, kanter. Apex' værdi i begge temaer; tekst på den: on-fill."
      },
      "on-fill": {
        "light": "#ffffff",
        "dark": "#ffffff",
        "use": "Tekst på info/ok/danger/violet-fill (≥ 4,9:1)."
      },
      "on-warn-fill": {
        "light": "#111214",
        "dark": "#111214",
        "use": "Tekst på warn-fill (9,7:1)."
      },
      "danger-surface": {
        "light": "#fcf0f0",
        "dark": {
          "tint": "danger",
          "chroma": 0.055,
          "dL": 0.045
        },
        "use": "Baggrund for fejlpanel, der ligger direkte på siden (ikke på et kort). Lyst: Apex' danger-muted."
      }
    },
    "data": {
      "data-return": {
        "ref": "dom-cool",
        "use": "Alias → dom-cool."
      },
      "data-outdoor": {
        "light": "#64707d",
        "dark": "#b2bfce",
        "use": "Udetemperatur."
      },
      "data-plan": {
        "ref": "dom-plan",
        "use": "Alias → dom-plan."
      },
      "data-pump": {
        "ref": "dom-water",
        "use": "Alias → dom-water."
      },
      "data-light": {
        "ref": "dom-light",
        "use": "Alias → dom-light."
      }
    },
    "domain": {
      "dom-heat": {
        "light": "#da5800",
        "dark": "#f67400",
        "use": "Varme: opvarmning, fremløb, varmt vand"
      },
      "dom-cool": {
        "light": "#196ea9",
        "dark": "#62ace8",
        "use": "Kulde: køling, retur, frost"
      },
      "dom-light": {
        "light": "#9b7300",
        "dark": "#ebbd57",
        "use": "Lys og sol: lamper tændt, solindstråling"
      },
      "dom-water": {
        "light": "#007a75",
        "dark": "#4ec3bd",
        "use": "Vand og luft: flow, vandforbrug, ventilation, fugt"
      },
      "dom-energy": {
        "light": "#007748",
        "dark": "#51bd85",
        "use": "Energi: egenproduktion, eksport, billig strøm, sparet energi"
      },
      "dom-nature": {
        "light": "#5b7f1d",
        "dark": "#a3cf68",
        "use": "Natur og liv: planter, have, vanding, personer hjemme"
      },
      "dom-security": {
        "light": "#4354ab",
        "dark": "#7e93e2",
        "use": "Sikkerhed: låse, alarm, døre og vinduer"
      },
      "dom-plan": {
        "light": "#724aab",
        "dark": "#b093e5",
        "use": "Plan og automatik: Odin, tidsplaner, scener, automationer"
      },
      "dom-media": {
        "light": "#a5397e",
        "dark": "#de82b7",
        "use": "Medier: musik, TV, højttalere"
      }
    },
    "scale": {
      "scale-good-bad-1": {
        "light": "#267d30",
        "dark": "#68c36d",
        "use": "5 trin fra godt til dårligt: pris (billig→dyr), luftkvalitet, batteri (fuld→tom), signal"
      },
      "scale-good-bad-2": {
        "light": "#6e7e01",
        "dark": "#b5ca4e",
        "use": "Trin 2 af 5."
      },
      "scale-good-bad-3": {
        "light": "#a87600",
        "dark": "#edc14d",
        "use": "Trin 3 af 5."
      },
      "scale-good-bad-4": {
        "light": "#c15800",
        "dark": "#f39340",
        "use": "Trin 4 af 5."
      },
      "scale-good-bad-5": {
        "light": "#b63132",
        "dark": "#ea6a64",
        "use": "Trin 5 af 5."
      },
      "scale-cold-warm-1": {
        "light": "#196ea9",
        "dark": "#348dcf",
        "use": "5 trin fra koldere til varmere end mål: blå ← neutral → orange"
      },
      "scale-cold-warm-2": {
        "light": "#7aa3c8",
        "dark": "#74a4cd",
        "use": "Trin 2 af 5."
      },
      "scale-cold-warm-3": {
        "light": "#d2d1cd",
        "dark": "#46484a",
        "use": "Trin 3 af 5."
      },
      "scale-cold-warm-4": {
        "light": "#e29a76",
        "dark": "#f9aa60",
        "use": "Trin 4 af 5."
      },
      "scale-cold-warm-5": {
        "light": "#db5600",
        "dark": "#f67400",
        "use": "Trin 5 af 5."
      }
    }
  },
